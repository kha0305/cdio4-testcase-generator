# Sanh file .env từ file này: copy .env.example .env
# Thay đổi các giá trị theo môi trường thực tế

# Bảo mật JWT - PHẢI đổi thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự
# Tạo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=doi_thanh_chuoi_ngau_nhien_rat_dai_o_day

# Thời hạn token (phút)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - Danh sách nguồn gốc cho phép, ngăn cách bằng dấu phẩy
# Development: CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Môi trường (development | production)
APP_ENV=development
